# Copy to .env.production on the deployment host; fill every blank.
NODE_ENV=production
PORT=3000
# Bind to loopback when a reverse proxy runs on the same host.
BIND_ADDRESS=127.0.0.1
APP_URL=
# Compose fixes DATABASE_URL to file:/app/data/prod.db on the persistent volume.
JWT_SECRET=
COOKIE_SECRET=
JWT_EXPIRES_IN=7d
# Use 1 only when the application is behind exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=1
TZ=Asia/Jakarta
ROOM_NAME=
ROOM_CAPACITY=12
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
