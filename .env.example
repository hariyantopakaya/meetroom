# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database Configuration
# Local SQLite (default for development):
DATABASE_URL="file:./dev.db"
# PostgreSQL (for Docker or Production):
# DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/booking_meeting?schema=public"

# Authentication / Security
JWT_SECRET=super_secret_jwt_key_booking_meeting_2026_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_key_booking_meeting_2026

# Email Configuration (Nodemailer)
# If left empty, emails will be logged to server console (development mode)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Booking Meeting <no-reply@bookingmeeting.local>"
