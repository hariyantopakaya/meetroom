# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database Configuration
# Local SQLite (default for development):
DATABASE_URL="file:./dev.db"
# This schema uses SQLite. Production settings are in .env.production.example.

# Authentication / Security
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECRET=

# Email Configuration (Nodemailer)
# If left empty, emails will be logged to server console (development mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Booking Meeting <no-reply@bookingmeeting.local>"

ROOM_NAME=
ROOM_CAPACITY=12
TRUST_PROXY_HOPS=0
# Demo seeding is destructive and disabled by default.
ALLOW_DEMO_SEED=false
